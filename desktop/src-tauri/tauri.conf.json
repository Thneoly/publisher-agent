{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "publisher-agent",
  "version": "0.1.0",
  "identifier": "com.thneoly.publisher-agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "publisher-agent 看板",
        "label": "main",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
